[Unit]
Description=ZengOS live desktop and installer
After=systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
User=root
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_CURRENT_DESKTOP=Zolt
# Lets the live desktop start in virtual machines and on GPUs without a driver.
Environment=WLR_RENDERER_ALLOW_SOFTWARE=1
ExecStart=/usr/bin/labwc -C /usr/share/zengos-live/labwc
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
